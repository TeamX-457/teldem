# Copy this file to `.env` and fill in real values for your environment.

# Core
DJANGO_SECRET_KEY=change-me-to-a-random-secret-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Local development defaults to SQLite automatically if DATABASE_URL is unset.
# For Postgres (staging/production):
# DATABASE_URL=postgres://teldem:teldem@localhost:5432/teldem
DATABASE_URL=

# Email (console backend used by default in dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TELDEM AI <no-reply@teldem.ai>

# Site
SITE_NAME=TELDEM AI
SITE_DOMAIN=localhost:8000
